/-- the telescoping lower bound for `Σ_{20 ≤ L < 10⁷}` of one forward chamber -/
def tailQ (f : FCell) : ℚ :=
  if 0 ≤ f.m then
    (f.m : ℚ) / 2 * (f.hi - f.lo) * (1 / (20 + ((f.lo + f.hi - 1) / 2 + 1 / 160)) -
      1 / (10000000 + ((f.lo + f.hi - 1) / 2 + 1 / 160)))
  else
    (f.m : ℚ) / 2 * (f.hi - f.lo) * (1 / (20 + (f.lo + f.hi - 1) / 2) -
      1 / (10000000 + (f.lo + f.hi - 1) / 2))

def tailInt : ℤ := (fcells.map (fun f => ⌊tailQ f * 1000000000000⌋)).sum

theorem tailInt_ge : (-86753172166 : ℤ) ≤ tailInt := by decide +kernel

theorem fcells_bds : fcells.all (fun f => decide (0 ≤ f.lo ∧ f.lo < f.hi ∧ f.hi ≤ 1)) = true := by
  decide +kernel

theorem fcells_e : fcells.all (fun f => decide (f.e = 1 ∨ f.e = 5)) = true := by decide +kernel

theorem dualTab_len :
    (List.range 20).all (fun L => decide ((dualTab.getD L []).length = fcells.length)) = true := by
  decide +kernel

theorem walls1_eq : (fcells.filter (fun f => decide (f.e = 1))).map (fun f => (f.lo, f.hi)) =
    walls1.zip walls1.tail := by decide +kernel

theorem walls5_eq : (fcells.filter (fun f => decide (f.e = 5))).map (fun f => (f.lo, f.hi)) =
    walls5.zip walls5.tail := by decide +kernel

theorem walls1_pw : walls1.Pairwise (· < ·) := by decide +kernel

theorem walls5_pw : walls5.Pairwise (· < ·) := by decide +kernel

theorem cellData_zero : (cellData 0).all (fun q => decide (q.1.lo = 0 → q.2 = 0)) = true := by
  decide +kernel

/-! ### Real-valued density and its lower bound -/

noncomputable def termR (L : ℕ) (q : FCell × ℤ) : ℝ :=
  if L = 0 ∧ q.1.lo = 0 then 0 else (q.2 : ℝ) / 2 * (1 / ((L : ℝ) + q.1.lo) - 1 / ((L : ℝ) + q.1.hi))

noncomputable def densR (L2 : ℕ) : ℝ := ∑ L ∈ range L2, ((cellData L).map (termR L)).sum

theorem termR_eq (L : ℕ) (q : FCell × ℤ) : termR L q = ((termQ L q : ℚ) : ℝ) := by
  unfold termR termQ
  split_ifs <;> push_cast <;> rfl

theorem list_sum_range {M : Type*} [AddCommMonoid M] (f : ℕ → M) (n : ℕ) :
    ((List.range n).map f).sum = ∑ i ∈ range n, f i := by
  induction n with
  | zero => simp
  | succ n ih => rw [List.range_succ, List.map_append, List.sum_append, ih, Finset.sum_range_succ]; simp

theorem list_sum_le {α : Type*} (l : List α) (g h : α → ℝ) (hgh : ∀ a ∈ l, g a ≤ h a) :
    (l.map g).sum ≤ (l.map h).sum := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.sum_cons]
    exact add_le_add (hgh a (by simp)) (ih (fun b hb => hgh b (by simp [hb])))

theorem floor_sum_le {α : Type*} (l : List α) (g : α → ℚ) (h : α → ℝ)
    (hg : ∀ a ∈ l, (g a : ℝ) ≤ h a) :
    (((l.map (fun a => ⌊g a * 1000000000000⌋)).sum : ℤ) : ℝ) ≤ 1000000000000 * (l.map h).sum := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.sum_cons, Int.cast_add, mul_add]
    have h1 : ((⌊g a * 1000000000000⌋ : ℤ) : ℝ) ≤ 1000000000000 * h a := by
      have h2 : ((⌊g a * 1000000000000⌋ : ℤ) : ℚ) ≤ g a * 1000000000000 := Int.floor_le _
      have h3 : ((⌊g a * 1000000000000⌋ : ℤ) : ℝ) ≤ ((g a * 1000000000000 : ℚ) : ℝ) := by
        exact_mod_cast h2
      have h4 := hg a (by simp)
      push_cast at h3
      linarith
    exact add_le_add h1 (ih (fun b hb => hg b (by simp [hb])))

theorem low_bound :
    (lowInt : ℝ) ≤ 1000000000000 * ∑ L ∈ range 20, ((cellData L).map (termR L)).sum := by
  unfold lowInt
  rw [list_sum_range, Int.cast_sum, Finset.mul_sum]
  exact Finset.sum_le_sum (fun L _ => floor_sum_le _ _ _ (fun q _ => (termR_eq L q).ge))

theorem zip_none (l : List FCell) :
    (l.zip (l.map (fun _ => (none : Option (ℤ × ℕ))))).map (fun p => (p.1, cellM p.1 p.2)) =
      l.map (fun f => (f, f.m)) := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [List.map_cons, List.zip_cons_cons, ih]; rfl

theorem cellData_large {L : ℕ} (h : 20 ≤ L) : cellData L = fcells.map (fun f => (f, f.m)) := by
  unfold cellData dualRow
  split_ifs with h'
  · omega
  · exact zip_none _

theorem sum_list_comm {α : Type*} (s : Finset ℕ) (l : List α) (g : ℕ → α → ℝ) :
    ∑ L ∈ s, (l.map (g L)).sum = (l.map (fun a => ∑ L ∈ s, g L a)).sum := by
  induction l with
  | nil => simp
  | cons a l ih => simp only [List.map_cons, List.sum_cons, Finset.sum_add_distrib, ih]

theorem telescope (c : ℝ) (M N : ℕ) (hMN : M ≤ N) :
    ∑ L ∈ Ico M N, (1 / ((L : ℝ) + c) - 1 / ((L : ℝ) + c + 1)) =
      1 / ((M : ℝ) + c) - 1 / ((N : ℝ) + c) := by
  induction N, hMN using Nat.le_induction with
  | base => simp
  | succ N hMN ih =>
    rw [Finset.sum_Ico_succ_top hMN, ih]
    push_cast
    ring

theorem term_lower (a b L : ℝ) (ha : 0 ≤ a) (hab : a < b) (hL : 20 ≤ L) :
    (b - a) * (1 / (L + ((a + b - 1) / 2 + 1 / 160)) - 1 / (L + ((a + b - 1) / 2 + 1 / 160) + 1)) ≤
      1 / (L + a) - 1 / (L + b) := by
  have h1 : 0 < L + a := by linarith
  have h2 : 0 < L + b := by linarith
  have h3 : 0 < L + ((a + b - 1) / 2 + 1 / 160) := by linarith
  have h4 : 0 < L + ((a + b - 1) / 2 + 1 / 160) + 1 := by linarith
  rw [div_sub_div _ _ h3.ne' h4.ne', div_sub_div _ _ h1.ne' h2.ne', mul_div_assoc',
    div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith [sq_nonneg (b - a), mul_pos h1 h2, mul_nonneg (sub_nonneg.2 hab.le) (sub_nonneg.2 hL)]

theorem term_upper (a b L : ℝ) (ha : 0 ≤ a) (hab : a < b) (hb : b ≤ 1) (hL : 20 ≤ L) :
    1 / (L + a) - 1 / (L + b) ≤
      (b - a) * (1 / (L + (a + b - 1) / 2) - 1 / (L + (a + b - 1) / 2 + 1)) := by
  have h1 : 0 < L + a := by linarith
  have h2 : 0 < L + b := by linarith
  have h3 : 0 < L + (a + b - 1) / 2 := by linarith
  have h4 : 0 < L + (a + b - 1) / 2 + 1 := by linarith
  rw [div_sub_div _ _ h3.ne' h4.ne', div_sub_div _ _ h1.ne' h2.ne', mul_div_assoc',
    div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith [mul_nonneg (sub_nonneg.2 hab.le) (by linarith : (0:ℝ) ≤ 1 - (b - a)), mul_pos h3 h4,
    mul_pos h1 h2]

theorem tail_sum (a b : ℝ) (m : ℤ) (ha : 0 ≤ a) (hab : a < b) (hb : b ≤ 1) (N : ℕ) (hN : 20 ≤ N) :
    (if 0 ≤ m then (m : ℝ) / 2 * (b - a) * (1 / (20 + ((a + b - 1) / 2 + 1 / 160)) -
        1 / ((N : ℝ) + ((a + b - 1) / 2 + 1 / 160)))
      else (m : ℝ) / 2 * (b - a) * (1 / (20 + (a + b - 1) / 2) - 1 / ((N : ℝ) + (a + b - 1) / 2)))
      ≤ ∑ L ∈ Ico 20 N, (m : ℝ) / 2 * (1 / ((L : ℝ) + a) - 1 / ((L : ℝ) + b)) := by
  split_ifs with hm
  · have ht := telescope ((a + b - 1) / 2 + 1 / 160) 20 N hN
    push_cast at ht
    rw [mul_assoc, ← ht, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_le_sum (fun L hL => ?_)
    have hL' : (20 : ℝ) ≤ L := by exact_mod_cast (Finset.mem_Ico.1 hL).1
    have hm0 : (0 : ℝ) ≤ m := by exact_mod_cast hm
    have hm' : (0 : ℝ) ≤ (m : ℝ) / 2 := by linarith
    exact mul_le_mul_of_nonneg_left (term_lower a b L ha hab hL') hm'
  · have ht := telescope ((a + b - 1) / 2) 20 N hN
    push_cast at ht
    rw [mul_assoc, ← ht, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_le_sum (fun L hL => ?_)
    have hL' : (20 : ℝ) ≤ L := by exact_mod_cast (Finset.mem_Ico.1 hL).1
    have hm0 : (m : ℝ) ≤ 0 := by exact_mod_cast (not_le.1 hm).le
    have hm' : (m : ℝ) / 2 ≤ 0 := by linarith
    exact mul_le_mul_of_nonpos_left (term_upper a b L ha hab hb hL') hm'

theorem tailQ_le (f : FCell) (hf : f ∈ fcells) :
    ((tailQ f : ℚ) : ℝ) ≤ ∑ L ∈ Ico 20 10000000, termR L (f, f.m) := by
  have hb := List.all_eq_true.1 fcells_bds f hf
  simp only [decide_eq_true_eq] at hb
  obtain ⟨h0, h1, h2⟩ := hb
  have e : ∀ L ∈ Ico 20 10000000, termR L (f, f.m) =
      (f.m : ℝ) / 2 * (1 / ((L : ℝ) + (f.lo : ℝ)) - 1 / ((L : ℝ) + (f.hi : ℝ))) := by
    intro L hL
    have : L ≠ 0 := by have := (Finset.mem_Ico.1 hL).1; omega
    simp [termR, this]
  rw [Finset.sum_congr rfl e]
  refine le_trans (le_of_eq ?_) (tail_sum (f.lo : ℝ) (f.hi : ℝ) f.m (by exact_mod_cast h0)
    (by exact_mod_cast h1) (by exact_mod_cast h2) 10000000 (by norm_num))
  unfold tailQ
  split_ifs <;> push_cast <;> ring

theorem tail_bound :
    (tailInt : ℝ) ≤ 1000000000000 * ∑ L ∈ Ico 20 10000000, ((cellData L).map (termR L)).sum := by
  have e : ∀ L ∈ Ico 20 10000000, ((cellData L).map (termR L)).sum =
      (fcells.map (fun f => termR L (f, f.m))).sum := by
    intro L hL
    rw [cellData_large (Finset.mem_Ico.1 hL).1, List.map_map]
    rfl
  rw [Finset.sum_congr rfl e, sum_list_comm]
  exact floor_sum_le _ _ _ (fun f hf => tailQ_le f hf)

/-- the numerical heart: the content exponent exceeds `β₀ = -1.3335` -/
theorem density_bound :
    (-13335 / 10000 : ℝ) < 12 * Real.log 2 + 18 * Real.log 3 + densR 10000000 - 16 / 10000000 := by
  have hsplit : densR 10000000 = ∑ L ∈ range 20, ((cellData L).map (termR L)).sum +
      ∑ L ∈ Ico 20 10000000, ((cellData L).map (termR L)).sum :=
    (Finset.sum_range_add_sum_Ico _ (by norm_num)).symm
  have h1 := low_bound
  have h2 := tail_bound
  have h3 : (-29339510908086 : ℝ) ≤ lowInt := by exact_mod_cast lowInt_ge
  have h4 : (-86753172166 : ℝ) ≤ tailInt := by exact_mod_cast tailInt_ge
  obtain ⟨l2, -⟩ := log_two_bounds
  obtain ⟨l3, -⟩ := log_three_bounds
  rw [hsplit]
  linarith

end Zeta2L2Chi3.Arith
