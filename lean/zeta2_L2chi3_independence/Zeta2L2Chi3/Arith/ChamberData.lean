/-- a list satisfies `all f` if each chunk of length `c` does -/
theorem all_chunks {α : Type*} (f : α → Bool) (c : ℕ) :
    ∀ (k : ℕ) (l : List α), l.length ≤ c * k →
      (∀ j < k, ((l.drop (c * j)).take c).all f = true) → l.all f = true
  | 0, l, hl, _ => by
    have : l = [] := List.eq_nil_of_length_eq_zero (by simpa using hl)
    subst this; rfl
  | k + 1, l, hl, h => by
    rw [← List.take_append_drop c l, List.all_append, Bool.and_eq_true]
    refine ⟨by simpa using h 0 (by omega), all_chunks f c k (l.drop c) ?_ (fun j hj => ?_)⟩
    · simp only [List.length_drop]; rw [Nat.mul_succ] at hl; omega
    · have := h (j + 1) (by omega)
      rw [List.drop_drop]
      rw [show c * (j + 1) = c * j + c by ring] at this
      first | exact this | (rw [Nat.add_comm]; exact this)

