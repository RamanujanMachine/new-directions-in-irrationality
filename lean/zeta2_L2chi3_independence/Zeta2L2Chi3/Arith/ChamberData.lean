import Zeta2L2Chi3.Arith.Checker

namespace Zeta2L2Chi3.Arith

structure FCell where
  e : ℕ
  lo : ℚ
  hi : ℚ
  m : ℤ

structure DCell where
  e : ℕ
  L : ℕ
  lo : ℚ
  hi : ℚ
  m : ℤ
  hints : List ℕ

def midpt (lo hi : ℚ) : ℚ := lo + (hi - lo) * 503 / 1009

def FCell.ok (c : FCell) : Bool :=
  wallFree (endpts (dualZ ++ dualP) c.e) c.lo c.hi (midpt c.lo c.hi) &&
  wallFree (endpts (fwdZ ++ fwdP) c.e) c.lo c.hi (midpt c.lo c.hi) &&
  wallFree1 (endpts (gammaF.map (·.1)) c.e) c.lo c.hi (midpt c.lo c.hi) &&
  decide (fwdCellBound c.e (midpt c.lo c.hi) = c.m)

def DCell.ok (c : DCell) : Bool :=
  decide (dualCellBound c.e ((c.L : ℚ) + midpt c.lo c.hi) (fun i _ => c.hints.contains i) = c.m)

